# Chat Server PHP — Variables de Entorno
# Copiar este archivo como .env y ajustar los valores

# ── Base de datos MySQL propia del chat ──────────────────────────────
CHAT_DB_HOST=localhost
CHAT_DB_PORT=3306
CHAT_DB_NAME=recetario_chat
CHAT_DB_USER=root
CHAT_DB_PASS=

# ── Secret compartido con Node.js ─────────────────────────────────────
# Debe coincidir con CHAT_SERVER_PASSWORD en el .env de RecetarioApp (Node.js)
CHAT_SECRET=change_me_in_production
